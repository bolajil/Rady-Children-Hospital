# AWS Production Environment Configuration
# Copy this to .env.aws and fill in your values

# ===========================================
# REQUIRED: Core API Keys
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key

# ===========================================
# LANGFUSE CONFIGURATION (LLM Observability)
# ===========================================
# Option 1: Self-hosted LangFuse on AWS
# Create API keys in your LangFuse instance at https://your-langfuse-domain.com
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://your-langfuse-domain.com

# Option 2: LangFuse Cloud (if not self-hosting)
# LANGFUSE_PUBLIC_KEY=pk-lf-your-cloud-public-key
# LANGFUSE_SECRET_KEY=sk-lf-your-cloud-secret-key
# LANGFUSE_HOST=https://cloud.langfuse.com

# ===========================================
# AWS INFRASTRUCTURE
# ===========================================
# Backend URL for frontend server-side calls (internal ALB or service discovery)
BACKEND_INTERNAL_URL=http://backend:8000

# Backend URL for client-side calls (public ALB URL)
BACKEND_PUBLIC_URL=http://your-alb-url.us-east-1.elb.amazonaws.com

# Redis URL (AWS ElastiCache or container)
REDIS_URL=redis://your-elasticache-endpoint:6379

# ===========================================
# LANGFUSE DATABASE (if self-hosting LangFuse)
# ===========================================
LANGFUSE_DATABASE_URL=postgresql://langfuse:password@your-rds-endpoint:5432/langfuse
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-random
LANGFUSE_SALT=your-salt-value-min-32-characters-random
LANGFUSE_PUBLIC_URL=https://your-langfuse-domain.com

# ===========================================
# APPLICATION SETTINGS
# ===========================================
MEMORY_TYPE=redis
SESSION_TIMEOUT=3600
ENVIRONMENT=production
LOG_LEVEL=INFO
