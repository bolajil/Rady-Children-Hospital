# Environment Configuration for Rady GenAI Backend

# OpenAI API Key (Required for full AI capabilities)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override model selection
# MODEL_NAME=gpt-4-turbo-preview

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Conversation Memory Settings
# Options: buffer (simple, in-memory), summary (summarizes old messages), redis (persistent)
MEMORY_TYPE=buffer

# Redis Configuration (only needed if MEMORY_TYPE=redis)
REDIS_URL=redis://redis:6379

# Session timeout in seconds (default: 1 hour)
SESSION_TIMEOUT=3600

# ============================================
# MONITORING CONFIGURATION
# ============================================

# LangFuse (Self-Hosted LLM Observability)
# Get keys from: http://localhost:3001 after creating account
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=http://localhost:3001

# LangSmith (LangChain Cloud Tracing - NOT HIPAA compliant)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key
# LANGCHAIN_PROJECT=rady-genai

# OpenTelemetry (Distributed Tracing)
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Arize Phoenix (LLM Observability)
# PHOENIX_ENABLED=true
# PHOENIX_ENDPOINT=http://localhost:4317
